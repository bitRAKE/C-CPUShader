-std=c17
-Wall
-Wextra
-Werror
-pedantic
-target x86_64-pc-windows-msvc
-DUNICODE
-D_UNICODE
-DWIN32_LEAN_AND_MEAN
-D_WIN32_WINNT=0x0A00
-march=native
-O3
-ffunction-sections
-fdata-sections
-fno-stack-protector
-ffreestanding
-fno-builtin
-luser32
-lgdi32
-lvulkan-1
-lcomctl32
-lshell32
-lole32
-lwindowscodecs
-ld3d12
-ldxgi
-ldxguid
-ld3dcompiler
-flto
-fuse-ld=lld
-Xlinker "-subsystem:windows,10.0"
-o bin.exe
src/main.c
src/display.c
src/stats.c
src/win.c
src/runtime_session.c
src/defines.c
src/capture_wic.c
src/shader_buffers.c
src/host/host_options.c
src/present/present_backend.c
src/dxgi/dxgi_support.c
src/dx12/backend_dx12.c
src/dx12/dx12_present_path_upload_buffer_srv.c
src/gdi/backend_gdi.c
src/ogl/backend_ogl.c
src/vk/backend_vk.c
src/app.res
src/shaders/sphere_tracing.c
src/shaders/kinetic_orbs.c
pocs/capture_animation/animated_sprite.c
pocs/capture_animation/orbit_stars.c
src/shaders/hsv_picker.c
src/shaders/glass_lenses.c
src/shaders/glass_disks.c
src/shaders/crystal_hall.c
src/shaders/master_class.c
src/shaders/master_class_scrgb.c
src/shaders/master_class_hdr10.c
src/shaders/colorspace_sdr_ui.c
src/shaders/colorspace_hdr_linear.c
src/shaders/colorspace_hdr10_pq.c
pocs/blue_wall_scene/blue_wall_v2_A.c
pocs/blue_wall_scene/blue_wall_v2_B.c
pocs/blue_wall_scene/blue_wall_v2_C.c
pocs/blue_wall_scene/blue_wall_v2_D.c
pocs/blue_wall_scene/blue_wall_v2_E.c
pocs/mtsdf/mtsdf_hello_world.c
pocs/sdf_fixed/sdf_fixed_hello_world.c
