-std=c17
-Wall
-Wextra
-Werror
-pedantic
-target x86_64-pc-windows-msvc
-DUNICODE
-D_UNICODE
-DWIN32_LEAN_AND_MEAN
-D_WIN32_WINNT=0x0A00
-march=native
-O3
-ffunction-sections
-fdata-sections
-fno-stack-protector
-ffreestanding
-fno-builtin
-luser32
-ld3d12
-ldxgi
-ldxguid
-ld3dcompiler
-flto
-fuse-ld=lld
-Xlinker "-subsystem:windows,10.0"
-o bin.exe
src/main.c
src/dxx12.c
src/win.c
src/defines.c
src/shaders/sphere_tracing.c
src/shaders/glass_lenses.c
src/shaders/glass_disks.c
src/shaders/crystal_hall.c
src/shaders/master_class.c
